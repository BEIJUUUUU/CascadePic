/* CascadePic — Fluent-inspired light theme.
 *
 * Design tokens
 *   canvas        #f5f6f8   page background
 *   surface       #ffffff   cards, inputs
 *   border        #e3e6ea   hairline dividers
 *   text          #14161a   primary copy
 *   text-muted    #6b7280   secondary copy
 *   accent        #0a6cff   primary interactive colour
 */

* {
    font-family: "Microsoft YaHei UI", "Segoe UI Variable Text", "Segoe UI";
    font-size: 9pt;
    color: #14161a;
}

QMainWindow,
QDialog,
QWidget {
    background-color: #f5f6f8;
}

/* ------------------------------------------------------------------ toolbar */

QToolBar#mainToolbar {
    background: #ffffff;
    border: none;
    border-bottom: 1px solid #e3e6ea;
    spacing: 4px;
    padding: 8px 14px;
}

QToolBar#mainToolbar::separator {
    background: #e3e6ea;
    width: 1px;
    margin: 6px 8px;
}

QToolBar#mainToolbar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 5px 9px;
    color: #14161a;
    font-weight: 500;
}

QToolBar#mainToolbar QToolButton:hover {
    background: rgba(10, 108, 255, 0.09);
    border-color: rgba(10, 108, 255, 0.18);
}

QToolBar#mainToolbar QToolButton:pressed {
    background: rgba(10, 108, 255, 0.18);
    border-color: rgba(10, 108, 255, 0.30);
}

QToolBar#mainToolbar QToolButton:checked {
    background: rgba(10, 108, 255, 0.13);
    border-color: rgba(10, 108, 255, 0.32);
    color: #0a5ad4;
}

QToolBar#mainToolbar QToolButton:disabled {
    color: #9aa1ac;
}

/* Grouped control container with a subtle tinted plate. */
QWidget#toolbarChip {
    background: #f2f4f7;
    border: 1px solid #e6e9ee;
    border-radius: 9px;
}

QLabel#toolbarLabel {
    color: #6b7280;
    font-size: 8.5pt;
    font-weight: 600;
    padding: 0 2px 0 2px;
}

/* --------------------------------------------------------------- inputs */

QComboBox {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 22px 4px 6px;
    min-height: 18px;
    color: #14161a;
    font-weight: 600;
}

QComboBox:hover {
    background: rgba(255, 255, 255, 0.85);
    border-color: #d8dde5;
}

QComboBox:focus {
    background: #ffffff;
    border-color: #0a6cff;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #d8dde5;
    border-radius: 8px;
    padding: 5px;
    outline: none;
    selection-background-color: rgba(10, 108, 255, 0.12);
    selection-color: #14161a;
}

/* --------------------------------------------------------------- sliders */

QSlider::groove:horizontal {
    height: 4px;
    background: #dde1e7;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3d8bff, stop:1 #0a6cff);
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #0a6cff;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #eaf2ff;
    border-width: 3px;
    margin: -6px 0;
}

/* --------------------------------------------------------------- overlay controls */

/* --------------------------------------------------------------- buttons */

QPushButton {
    background: #ffffff;
    border: 1px solid #d8dde5;
    border-radius: 7px;
    padding: 7px 14px;
    color: #14161a;
    font-weight: 600;
}

QPushButton:hover {
    background: #f4f7fb;
    border-color: #b9c4d2;
}

QPushButton:pressed {
    background: #e9eef5;
}

QPushButton#playButton {
    background: #0a6cff;
    border: none;
    border-radius: 17px;
    min-width: 34px;
    min-height: 34px;
    max-width: 34px;
    max-height: 34px;
    padding: 0;
}

QPushButton#playButton:hover {
    background: #2b81ff;
}

QPushButton#playButton:pressed {
    background: #0857cc;
}

QPushButton#playButton:disabled {
    background: #c4ccd6;
}

QPushButton#loopButton {
    background: #ffffff;
    border: 1px solid #d8dde5;
    border-radius: 17px;
    padding: 0;
}

QPushButton#loopButton:hover {
    border-color: #0a6cff;
    background: #f4f9ff;
}

QPushButton#loopButton:checked {
    background: #eaf2ff;
    border-color: #0a6cff;
}

QPushButton#loopButton:disabled {
    background: #f0f1f3;
    border-color: #e3e6ea;
}

/* --------------------------------------------------------------- video */

QWidget#videoControls {
    background: #ffffff;
    border-top: 1px solid #e3e6ea;
}

QWidget#videoSurface,
QGraphicsView#imageCanvas {
    background: #101317;
    border: none;
}

QLabel#timeLabel {
    color: #6b7280;
    font-weight: 600;
}

QLabel#volumeIcon {
    padding-left: 4px;
}

/* --------------------------------------------------------------- status bar */

QStatusBar {
    background: #ffffff;
    border-top: 1px solid #e3e6ea;
    color: #6b7280;
    min-height: 26px;
    padding: 0 14px;
}

QStatusBar::item {
    border: none;
}

/* --------------------------------------------------------------- scrollbars */

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px 3px 2px 0;
}

QScrollBar::handle:vertical {
    background: #c9cfd8;
    border-radius: 4px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: #a9b2bf;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
}

/* --------------------------------------------------------------- tooltip */

QToolTip {
    background: #1f2329;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 5px 9px;
}
